    text-transform: uppercase;
}

.desk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
}

.desk-link {
    padding: 25px 20px;

    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
}

.desk-link:nth-child(3n) {
    border-right: 0;
}

.desk-link:hover {
    background: var(--yellow);
}

.desk-number {
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .12em;
    color: var(--muted);
}

.desk-name {
    margin-top: 7px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
}

.desk-role {
    margin-top: 8px;

    font-size: 9px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
}


/* ============================================================
   LOADING / ERROR
============================================================ */

.loading {
    padding: 70px 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 30px;
}

.error {
    padding: 40px;

    border: 2px solid var(--line);
    background: white;

    font-weight: 700;
}


/* ============================================================
   FOOTER
============================================================ */

footer {
    border-top: 2px solid var(--line);

    padding: 25px 4vw;

    display: flex;
    justify-content: space-between;
    gap: 20px;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
}


/* ============================================================
   MOBILE
============================================================ */

@media (max-width: 900px) {

    .pipeline-flow {
        grid-template-columns: repeat(2, 1fr);
    }

    .pipeline-step:nth-child(2) {
        border-right: 0;
    }

    .pipeline-step:nth-child(-n + 2) {
        border-bottom: 1px solid var(--line);
    }

    .desk-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .desk-link:nth-child(3n) {
        border-right: 1px solid var(--line);
    }

    .desk-link:nth-child(2n) {
        border-right: 0;
    }
}

@media (max-width: 800px) {

    .masthead-row {
        display: block;
    }

    .masthead-note {
        margin-top: 30px;
    }

    .briefing-intro {
        display: block;
    }

    .briefing-intro p {
        margin-top: 25px;
    }

    .story-grid {
        grid-template-columns: 1fr;
    }

    .story-card {
        border-right: 0;
