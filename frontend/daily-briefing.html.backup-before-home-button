    elena_vasquez: "Elena Vasquez",
    marcus_okafor: "Marcus Okafor",
    kenji_nakamura: "Kenji Nakamura",
    sofia_lindqvist: "Sofia Lindqvist"

};


/* ============================================================
   SAFETY
============================================================ */

function escapeHtml(value) {

    if (
        value === null ||
        value === undefined
    ) {
        return "";
    }

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


/* ============================================================
   GENERIC / EMPTY TITLES
============================================================ */

function isGenericHeadline(title) {

    if (!title) {
        return true;
    }

    const cleaned =
        String(title)
            .trim()
            .toLowerCase();

    return (
        cleaned === "machina daily bulletin" ||
        cleaned === "daily bulletin" ||
        cleaned === "machina bulletin"
    );
}


/* ============================================================
   GET A PROPER STORY FROM A DESK
============================================================ */

function getDeskStory(deskData) {

    if (!deskData) {
        return null;
    }


    /*
       First preference:
       the current latest article.
    */

    const latest =
        deskData.latest || null;

    if (
        latest &&
        !isGenericHeadline(
            latest.title
        ) &&
        (
            latest.body ||
            latest.article ||
            latest.selected_records
        )
    ) {

        return {
            ...latest,
            story_source: "latest"
        };

    }


    /*
       Second preference:
       current journalist article.
    */

    const article =
        deskData.journalist?.article ||
        deskData.article ||
        null;

    if (
        article &&
        !isGenericHeadline(
            article.title
        ) &&
        (
            article.body ||
            article.content
        )
    ) {

        return {
            ...article,
            story_source: "latest"
        };

    }


    /*
       Third preference:
       most recent proper archived story.

       This is the important fallback.

       If a desk did not produce a new usable
       story today, we show its most recent
       real article instead.
    */

    const history =
        Array.isArray(
            deskData.history
        )
            ? deskData.history
            : [];


    for (
        const oldStory of history
    ) {

        if (
            oldStory &&
            !isGenericHeadline(
                oldStory.title
            ) &&
            (
                oldStory.body ||
                oldStory.content ||
                oldStory.article
            )
        ) {

            return {
                ...oldStory,
                story_source: "previous"
            };

        }

    }


    /*
       Last resort:
       selected record title.
    */

    const records =
        deskData.journalist?.selected_records ||
        deskData.selected_records ||
        [];

    if (
        records.length &&
        records[0].title
    ) {

        return {
            title: records[0].title,
            body: "",
            story_source: "record"
        };

    }


    return null;
}


/* ============================================================
   GET HEADLINE
============================================================ */

function getHeadline(
    story,
    yukiStory = null
) {

    /*
       If Yuki supplied an exact assigned story title,
       preserve it for today's selected stories.
    */

    if (
        yukiStory &&
        yukiStory.assigned_story_title
    ) {

        return yukiStory.assigned_story_title;

    }


    if (
        story &&
        story.title &&
        !isGenericHeadline(
            story.title
        )
    ) {

        return story.title;

    }


    return "Machina Daily Bulletin";
}


/* ============================================================
   LOAD INDIVIDUAL DESK
============================================================ */

async function loadDesk(id) {

    try {

        const response =
            await fetch(
                "/daily/" +
                id +
                "/data"
            );

        if (!response.ok) {
            return null;
        }

        return await response.json();

    } catch (error) {

        console.error(
            "Could not load desk:",
            id,
            error
        );

        return null;
    }
}


/* ============================================================
   LOAD DAILY BRIEFING
============================================================ */

async function loadBriefing() {

    try {

        const response =
            await fetch(
                "/daily-briefing/data"
            );

        if (!response.ok) {

            throw new Error(
                "Briefing API returned " +
                response.status
            );
        }

        const data =
            await response.json();


        /* ----------------------------------------------------
           DATE
        ---------------------------------------------------- */

        const generatedAt =
            data.generated_at;

        if (generatedAt) {

            const date =
                new Date(
                    generatedAt
                );

            document.getElementById(
                "headerDate"
            ).textContent =
                date.toLocaleDateString(
                    "en-GB",
                    {
                        weekday: "long",
                        day: "numeric",
                        month: "long",
                        year: "numeric"
                    }
                );
        }


        /* ----------------------------------------------------
           LOAD ALL NINE DESKS
        ---------------------------------------------------- */

        const loaded =
            await Promise.all(
                DESKS.map(
                    async journalist_id => {

                        const desk =
                            await loadDesk(
                                journalist_id
                            );

                        return {
                            journalist_id,
                            desk
                        };

                    }
                )
            );


        /*
           Build lookup by journalist ID.
        */

        const deskMap =
            {};

        loaded.forEach(
            item => {

                deskMap[
                    item.journalist_id
                ] = item.desk;

            }
        );


        /* ----------------------------------------------------
           YUKI'S TOP FIVE
        ---------------------------------------------------- */

        const yukiTopFive =
            Array.isArray(
                data.yuki?.top_five
            )
                ? data.yuki.top_five
                : [];


        const selectedIds =
            new Set(
                yukiTopFive.map(
                    item =>
                        item.journalist_id
                )
            );


        /*
           Today's selected stories.

           These are deliberately ordered by Yuki's
           ranking rather than by desk number.
        */

        const selectedStories =
            yukiTopFive
                .map(
                    yukiStory => {

                        const id =
                            yukiStory.journalist_id;

                        const deskData =
                            deskMap[id];

                        const story =
                            getDeskStory(
                                deskData
                            );

                        if (!story) {
                            return null;
                        }

                        return {
                            journalist_id: id,
                            deskData,
                            story,
                            yukiStory,
                            selected: true
                        };

                    }
                )
                .filter(Boolean);


        /*
           Remaining four desks.

           These do NOT compete with Yuki's ranking.

           They simply provide the latest available
           story from that desk, falling back to history.
        */

        const previousDeskStories =
            DESKS
                .filter(
                    id =>
                        !selectedIds.has(id)
                )
                .map(
                    id => {

                        const deskData =
                            deskMap[id];

                        const story =
                            getDeskStory(
                                deskData
                            );

                        if (!story) {
                            return null;
                        }

                        return {
                            journalist_id: id,
                            deskData,
                            story,
                            yukiStory: null,
                            selected: false
                        };

                    }
                )
                .filter(Boolean);


        /*
           Final order:

           1–5 = Yuki's selections
           6–9 = latest available stories
                 from the remaining desks
        */

        const stories =
            [
                ...selectedStories,
                ...previousDeskStories
            ];


        if (!stories.length) {

            document.getElementById(
                "topStory"
            ).innerHTML =
                "<div class='error'>No specialist bulletins were available for today's briefing.</div>";

            document.getElementById(
                "storyGrid"
            ).innerHTML = "";

            return;
        }


        renderBriefing(
            stories
        );

    } catch (error) {

        console.error(
            error
        );

        document.getElementById(
            "topStory"
        ).innerHTML = `
            <div class="error">
                THE DAILY BRIEFING COULD NOT LOAD.
                <br><br>
                The editorial data endpoint could not be reached.
            </div>
        `;

    }
}


/* ============================================================
   RENDER BRIEFING
============================================================ */

function renderBriefing(
    stories
) {

    const first =
        stories[0];

    const firstDesk =
        first.deskData || {};

    const firstStory =
        first.story || {};


    const firstName =
        DISPLAY_NAMES[
            first.journalist_id
        ] ||
        first.journalist_id;


    const firstHeadline =
        getHeadline(
            firstStory,
            first.yukiStory
        );


    const firstRole =
        firstDesk.journalist?.role ||
        firstDesk.role ||
        "Editorial Desk";


    /*
       Yuki's #1 story becomes the large lead.
    */

    document.getElementById(
        "topStory"
    ).innerHTML = `

        <article class="top-story">

            <div class="story-meta">

                <span class="rank">
                    01
                </span>

                <span class="desk-label">
                    ${escapeHtml(firstRole)}
                </span>

            </div>


            <h2>
                ${escapeHtml(firstHeadline)}
            </h2>


            <div class="byline">
                ${escapeHtml(firstName)}
            </div>


            <a
                class="read-desk"
                href="/daily/${first.journalist_id}"
            >
                READ STORY →
            </a>

        </article>
    `;


    /* --------------------------------------------------------
       REMAINING EIGHT DESKS
    -------------------------------------------------------- */

    const remaining =
        stories.slice(1);


    const grid =
        document.getElementById(
            "storyGrid"
        );


    grid.innerHTML =
        remaining.map(
            (item, index) => {

                const deskData =
                    item.deskData || {};

                const story =
                    item.story || {};


                const name =
                    DISPLAY_NAMES[
                        item.journalist_id
                    ] ||
                    item.journalist_id;


                const headline =
                    getHeadline(
                        story,
                        item.yukiStory
                    );


                const role =
                    deskData.journalist?.role ||
                    deskData.role ||
                    "Editorial Desk";


                const rank =
                    String(
                        index + 2
                    ).padStart(
                        2,
                        "0"
                    );


                const statusLabel =
                    item.selected
                        ? "LATEST UPDATE"
                        : (
                            story.story_source === "previous"
                                ? "LATEST FROM THE DESK"
                                : "LATEST UPDATE"
                        );


                const statusClass =
                    item.selected
                        ? "selected"
                        : "previous";


                return `

                    <article
                        class="story-card"
                    >

                        <div class="card-number">
                            ${rank}
                        </div>


                        <div class="card-role">
                            ${escapeHtml(
                                role
                            )}
                        </div>


                        <h3>
                            ${escapeHtml(
                                headline
                            )}
                        </h3>


                        <div class="card-byline">
                            ${escapeHtml(
                                name
                            )}
                        </div>


                        <div
                            class="card-status ${statusClass}"
                        >
                            ${escapeHtml(
                                statusLabel
                            )}
                        </div>


                        <a
                            class="card-link"
                            href="/daily/${item.journalist_id}"
                        >
                            READ STORY →
                        </a>

                    </article>
                `;
            }
        ).join("");
}


/* ============================================================
   START
============================================================ */

loadBriefing();

</script>

