<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Machina Daily — Daily Briefing</title>

<style>

:root {
    --paper: #f5f2e9;
    --white: #fffdf8;
    --ink: #111111;
    --muted: #66615a;
    --line: #171717;
    --yellow: #e7d600;
    --red: #e33b2f;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font: inherit;
}


/* ============================================================
   HEADER
============================================================ */

.site-header {
    border-bottom: 2px solid var(--line);
    background: var(--paper);
}

.header-top {
    padding: 18px 4vw;
    border-bottom: 1px solid var(--line);

    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
}

.mini-brand {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.header-date {
    font-size: 11px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .1em;
}

.masthead-row {
    padding: 35px 4vw 30px;

    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
}

.masthead {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(64px, 12vw, 170px);
    line-height: .75;
    letter-spacing: -.075em;
}

.masthead-note {
    max-width: 300px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 18px;
    line-height: 1.15;
}

.nav {
    border-top: 1px solid var(--line);

    display: flex;
    overflow-x: auto;
}

.nav a {
    flex: 0 0 auto;

    padding: 14px 22px;

    border-right: 1px solid var(--line);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.nav a:hover {
    background: var(--yellow);
}


/* ============================================================
   MAIN
============================================================ */

main {
    width: min(1500px, 92vw);
    margin: 0 auto;
}


/* ============================================================
   SECTION INTRO
============================================================ */

.briefing-intro {
    padding: 55px 0 35px;

    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;

    border-bottom: 2px solid var(--line);
}

.section-kicker {
    margin-bottom: 15px;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.briefing-intro h1 {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(48px, 7vw, 100px);
    line-height: .85;
    letter-spacing: -.055em;
}

.briefing-intro p {
    max-width: 430px;
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 19px;
    line-height: 1.25;
}


/* ============================================================
   TOP STORY
============================================================ */

.top-story {
    padding: 45px 0 60px;

    border-bottom: 2px solid var(--line);
}

.story-meta {
    display: flex;
    align-items: center;
    gap: 12px;

    margin-bottom: 18px;
}

.rank {
    display: inline-block;

    padding: 6px 9px;

    background: var(--yellow);

    font-size: 10px;
    font-weight: 900;
    letter-spacing: .1em;
}

.desk-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
}

.top-story h2 {
    max-width: 1050px;
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 7vw, 96px);
    line-height: .91;
    letter-spacing: -.055em;
}

.byline {
    margin-top: 20px;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: .09em;
    text-transform: uppercase;
}

.top-story-body {
    max-width: 900px;
    margin-top: 30px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(21px, 2.2vw, 29px);
    line-height: 1.4;
}

.read-desk {
    display: inline-block;

    margin-top: 30px;
    padding: 12px 17px;

    border: 1px solid var(--line);

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.read-desk:hover {
    background: var(--ink);
    color: var(--paper);
}


/* ============================================================
   STORY GRID
============================================================ */

.story-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);

    border-bottom: 2px solid var(--line);
}

.story-card {
    padding: 35px 35px 42px;

    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
}

.story-card:nth-child(2n) {
    border-right: 0;
}

.story-card:nth-last-child(-n + 2) {
    border-bottom: 0;
}

.card-number {
    margin-bottom: 18px;

    font-family: Georgia, "Times New Roman", serif;
    font-size: 38px;
    line-height: 1;
}

.story-card h3 {
    margin: 0;

    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(27px, 3.5vw, 45px);
    line-height: .96;
    letter-spacing: -.035em;
}

.card-role {
    margin-bottom: 10px;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
}

.card-byline {
    margin-top: 15px;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
}

.card-status {
    margin-top: 10px;

    font-size: 9px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
}

.card-status.selected {
    color: var(--ink);
}

.card-status.previous {
    color: var(--muted);
}

.card-link {
    display: inline-block;

    margin-top: 24px;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;

    border-bottom: 1px solid var(--line);
}

.card-link:hover {
    background: var(--yellow);
}


/* ============================================================
   EDITORIAL STRIP
============================================================ */

.editorial-strip {
    margin: 55px 0;

    display: grid;
    grid-template-columns: .7fr 1.3fr;

    border: 2px solid var(--line);
}

.editorial-label {
    padding: 30px;

    background: var(--ink);
    color: var(--paper);

    font-size: 11px;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
}

.editorial-copy {
    padding: 30px;

    background: var(--white);

    font-family: Georgia, "Times New Roman", serif;
    font-size: 25px;
    line-height: 1.2;
}


/* ============================================================
   NEWSROOM PIPELINE
============================================================ */

.pipeline {
    margin: 70px 0 55px;

    border-top: 2px solid var(--line);
    border-bottom: 2px solid var(--line);
}

.pipeline-heading {
    padding: 20px 0;

    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;

    border-bottom: 1px solid var(--line);
}

.pipeline-heading h2 {
