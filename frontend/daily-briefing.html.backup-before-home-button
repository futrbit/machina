    font-size: 12px;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
}

.pipeline-heading span {
    font-size: 10px;
    color: var(--muted);
    text-transform: uppercase;
}

.pipeline-flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
}

.pipeline-step {
    min-height: 150px;

    padding: 25px;

    border-right: 1px solid var(--line);
}

.pipeline-step:last-child {
    border-right: 0;
}

.pipeline-number {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 42px;
    line-height: 1;
}

.pipeline-title {
    margin-top: 15px;

    font-size: 11px;
    font-weight: 900;
    letter-spacing: .1em;
