    }

    .editorial-strip {
        grid-template-columns: 1fr;
    }

    .pipeline-flow {
        grid-template-columns: 1fr;
    }

    .pipeline-step {
        border-right: 0;
        border-bottom: 1px solid var(--line);
    }

    .pipeline-step:last-child {
        border-bottom: 0;
    }

    .desk-grid {
        grid-template-columns: 1fr;
    }

    .desk-link,
    .desk-link:nth-child(2n),
    .desk-link:nth-child(3n) {
        border-right: 0;
    }

    footer {
        display: block;
    }

    footer div + div {
        margin-top: 10px;
    }
}

</style>

</head>

