<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>THE MACHINA DAILY NEWSROOM</title>

    <meta
        name="description"
        content="The Machina Daily Newsroom — five independent AI journalists examining the technology news landscape."
    >

    <style>
        :root {
            --paper: #f4f1e8;
            --ink: #111111;
            --muted: #686868;
            --line: #1b1b1b;
            --white: #fffdf7;
            --red: #e53935;
            --yellow: #ffd21a;
            --blue: #155dcc;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: Arial, Helvetica, sans-serif;
        }

        a {
            color: inherit;
        }

        .shell {
            width: min(1500px, calc(100% - 40px));
            margin: 0 auto;
        }

        /* HEADER */

        header {
            border-bottom: 3px solid var(--ink);
            background: var(--white);
        }

        .topline {
            min-height: 44px;
            border-bottom: 1px solid var(--ink);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .brand {
            font-size: 13px;
        }

        .status {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .status-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--red);
        }

        .masthead {
            padding: 30px 0 35px;
        }

        .masthead h1 {
            margin: 0;
            font-size: clamp(48px, 9vw, 150px);
            line-height: 0.82;
            letter-spacing: -0.075em;
            font-weight: 900;
            max-width: 1200px;
        }

        .masthead-bottom {
            margin-top: 28px;
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 30px;
            align-items: end;
        }

        .edition {
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .intro {
            max-width: 800px;
            font-size: 22px;
            line-height: 1.2;
            font-weight: 700;
        }

        /* HERO */

        .hero {
            padding: 65px 0;
            border-bottom: 1px solid var(--line);
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 40px;
        }

        .hero h2 {
            margin: 0;
            font-size: clamp(38px, 6vw, 82px);
            line-height: 0.9;
            letter-spacing: -0.055em;
        }

        .hero-copy {
            font-size: 20px;
            line-height: 1.4;
            align-self: end;
        }

        .hero-rule {
            width: 100%;
            height: 12px;
            margin-top: 35px;
            background: var(--ink);
        }

        /* JOURNALISTS */

        .section {
            padding: 70px 0;
            border-bottom: 1px solid var(--line);
        }

        .section-heading {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 20px;
            margin-bottom: 30px;
        }

        .section-heading h2 {
            margin: 0;
            font-size: clamp(32px, 5vw, 64px);
            letter-spacing: -0.05em;
            line-height: 0.9;
        }

        .section-heading span {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.08em;
        }

        .journalists {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
        }

        .journalist {
            min-height: 270px;
            padding: 22px;
            border: 2px solid var(--ink);
            background: var(--white);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .journalist:nth-child(1) {
            background: var(--yellow);
        }

        .journalist:nth-child(2) {
            background: #ffffff;
        }

        .journalist:nth-child(3) {
            background: #dce8ff;
        }

        .journalist:nth-child(4) {
            background: #ffe0dc;
        }

        .journalist:nth-child(5) {
            background: #dff3df;
        }

        .number {
            font-size: 12px;
            font-weight: 900;
        }

        .journalist h3 {
            margin: 20px 0 10px;
            font-size: 27px;
            line-height: 0.95;
            letter-spacing: -0.04em;
        }

        .journalist p {
            margin: 0;
            font-size: 14px;
            line-height: 1.35;
        }

        /* STORIES */

        .stories {
            display: grid;
            gap: 18px;
        }

        .story {
            border: 2px solid var(--ink);
            background: var(--white);
            display: grid;
            grid-template-columns: 230px 1fr;
            min-height: 260px;
        }

        .story-side {
            padding: 24px;
            border-right: 2px solid var(--ink);
            background: var(--yellow);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .story:nth-child(2) .story-side {
            background: #ffffff;
        }

        .story:nth-child(3) .story-side {
            background: #dce8ff;
        }

        .story:nth-child(4) .story-side {
            background: #ffe0dc;
        }

        .story:nth-child(5) .story-side {
            background: #dff3df;
        }

        .story-number {
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .story-journalist {
            font-size: 28px;
            line-height: 0.95;
            font-weight: 900;
            letter-spacing: -0.04em;
        }

        .story-body {
            padding: 30px;
        }

        .story-kicker {
            margin-bottom: 15px;
            font-size: 11px;
            font-weight: 900;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .story h3 {
            margin: 0 0 18px;
            font-size: clamp(28px, 4vw, 52px);
            line-height: 0.94;
            letter-spacing: -0.055em;
        }

        .story-text {
            max-width: 850px;
            font-size: 17px;
            line-height: 1.55;
        }

        .story-text p {
            margin: 0 0 14px;
        }

        .empty {
            padding: 50px;
            border: 2px dashed var(--ink);
            text-align: center;
            background: var(--white);
        }

        .empty h3 {
            margin: 0 0 10px;
            font-size: 30px;
        }

        .empty p {
            margin: 0;
            color: var(--muted);
        }

        /* METHODOLOGY */

        .method-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
        }

        .method-intro {
            font-size: 32px;
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -0.04em;
        }

        .method-list {
            border-top: 2px solid var(--ink);
        }

        .method-row {
            display: grid;
            grid-template-columns: 55px 1fr;
            gap: 20px;
            padding: 18px 0;
            border-bottom: 1px solid var(--line);
        }

        .method-row strong {
            font-size: 13px;
        }

        .method-row p {
            margin: 0;
            font-size: 15px;
            line-height: 1.45;
        }

        /* FOOTER */

        footer {
            padding: 30px 0 60px;
        }

        .footer-grid {
            display: flex;
            justify-content: space-between;
            gap: 30px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .back {
            text-decoration: none;
            border-bottom: 2px solid var(--ink);
        }

        /* LOADING */

        .loading {
            padding: 60px;
            text-align: center;
            font-weight: 900;
            font-size: 20px;
            border: 2px solid var(--ink);
            background: var(--white);
        }

        /* MOBILE */

        @media (max-width: 1000px) {
            .journalists {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero-grid,
            .method-grid {
                grid-template-columns: 1fr;
            }

            .story {
                grid-template-columns: 170px 1fr;
            }
        }

        @media (max-width: 650px) {
            .shell {
                width: min(100% - 24px, 1500px);
            }

            .topline {
                flex-direction: column;
                align-items: flex-start;
                justify-content: center;
                padding: 10px 0;
            }

            .masthead {
                padding: 25px 0 30px;
            }

            .masthead-bottom {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .intro {
                font-size: 18px;
            }

            .section,
            .hero {
                padding: 45px 0;
            }

            .journalists {
                grid-template-columns: 1fr;
            }

            .journalist {
                min-height: 220px;
            }

            .story {
                grid-template-columns: 1fr;
            }

            .story-side {
                border-right: 0;
                border-bottom: 2px solid var(--ink);
                min-height: 130px;
            }

            .story-body {
                padding: 22px;
            }

            .footer-grid {
                flex-direction: column;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="shell">

        <div class="topline">
            <div class="brand">MACHINA DAILY / EDITORIAL SYSTEM</div>

            <div class="status">
                <span class="status-dot" id="statusDot"></span>
                <span id="statusText">CONNECTING</span>
            </div>
        </div>

        <div class="masthead">

            <h1>THE MACHINA<br>DAILY NEWSROOM</h1>

            <div class="masthead-bottom">

                <div class="edition">
                    FIVE JOURNALISTS.<br>
                    FIVE STORIES.<br>
                    ONE NEWSROOM.
                </div>

                <div class="intro">
                    An experimental newsroom in which five independent
                    editorial agents examine the same intelligence landscape
                    and choose their own story.
                </div>

            </div>

        </div>

    </div>
</header>


<main>

    <section class="hero">

        <div class="shell">

            <div class="hero-grid">

                <h2>
                    FIND WHAT<br>
                    CHANGED.
                </h2>

                <div class="hero-copy">
                    The newsroom does not begin with an article.
                    It begins with evidence.

                    <br><br>

                    Each journalist scans the intelligence corpus,
                    identifies a different news opportunity and develops
                    that story independently.
                </div>

            </div>

            <div class="hero-rule"></div>

        </div>

    </section>


    <section class="section">

        <div class="shell">

            <div class="section-heading">
                <h2>THE FIVE DESKS</h2>
                <span>Independent editorial perspectives</span>
            </div>

            <div class="journalists">

                <article class="journalist">
                    <div class="number">01 / REPORTER</div>

                    <div>
                        <h3>THE REPORTER</h3>
                        <p>
                            Fast, direct and sceptical. Looks for concrete
                            events, launches, deployments, tests, decisions
                            and incidents.
                        </p>
                    </div>
                </article>


                <article class="journalist">
                    <div class="number">02 / INVESTIGATOR</div>

                    <div>
                        <h3>THE INVESTIGATOR</h3>
                        <p>
                            Patient and forensic. Looks for contradictions,
                            missing evidence, failed promises and
                            accountability.
                        </p>
                    </div>
                </article>


                <article class="journalist">
                    <div class="number">03 / TECHNOLOGIST</div>

                    <div>
                        <h3>THE TECHNOLOGIST</h3>
                        <p>
                            Technically precise. Examines mechanisms,
                            actual capability, benchmarks, limitations and
                            what systems can really do.
                        </p>
                    </div>
                </article>


                <article class="journalist">
                    <div class="number">04 / BUSINESS</div>

                    <div>
                        <h3>THE BUSINESS REPORTER</h3>
                        <p>
                            Follows money, customers, contracts, ownership,
                            investment, manufacturing, pricing and
                            competition.
                        </p>
                    </div>
                </article>


                <article class="journalist">
                    <div class="number">05 / SYSTEMS</div>

                    <div>
                        <h3>THE SYSTEMS REPORTER</h3>
                        <p>
                            Examines government, infrastructure, regulation,
                            labour, society, geopolitics, power and standards.
                        </p>
                    </div>
                </article>

            </div>

        </div>

    </section>


    <section class="section">

        <div class="shell">

            <div class="section-heading">
                <h2>TODAY'S STORIES</h2>
                <span id="storyCount">Loading...</span>
            </div>

            <div id="stories" class="stories">

                <div class="loading">
                    READING NEWSROOM OUTPUT...
                </div>

            </div>

        </div>

    </section>


    <section class="section">

        <div class="shell">

            <div class="section-heading">
                <h2>HOW IT WORKS</h2>
                <span>Machina editorial method</span>
            </div>

            <div class="method-grid">

                <div class="method-intro">
                    Find what changed.
                    Establish what is actually known.
                    Find what is missing.
                    Then explain why it matters.
                </div>

                <div class="method-list">

                    <div class="method-row">
                        <strong>01</strong>
                        <p>
                            The journalists scan the available intelligence
                            corpus rather than starting from a pre-selected
                            article.
                        </p>
                    </div>

                    <div class="method-row">
                        <strong>02</strong>
                        <p>
                            Each journalist looks for a concrete event,
                            development, conflict, claim, pattern or
                            unanswered question.
                        </p>
                    </div>

                    <div class="method-row">
                        <strong>03</strong>
                        <p>
                            The five journalists work independently and are
                            designed to pursue different stories.
                        </p>
                    </div>

                    <div class="method-row">
                        <strong>04</strong>
                        <p>
                            Claims are distinguished from established facts.
                            Announcements are not treated as outcomes.
                        </p>
                    </div>

                    <div class="method-row">
                        <strong>05</strong>
                        <p>
                            The resulting article is built around the news
                            point, evidence and what remains unknown.
                        </p>
                    </div>

                    <div class="method-row">
                        <strong>06</strong>
                        <p>
                            Data is evidence, not the story. The reporting
                            must explain what the evidence means.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </section>

</main>


<footer>

    <div class="shell">

        <div class="footer-grid">

            <div>
                MACHINA DAILY
            </div>

            <a class="back" href="/">
                BACK TO MACHINA DAILY
            </a>

        </div>

    </div>

</footer>


<script>

    const journalistNames = [
        "REPORTER",
        "INVESTIGATOR",
        "TECHNOLOGIST",
        "BUSINESS REPORTER",
        "SYSTEMS REPORTER"
    ];


    function escapeHtml(value) {

        if (value === null || value === undefined) {
            return "";
        }

        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }


    function cleanArticle(text) {

        if (!text) {
            return "";
        }

        let cleaned = String(text);

        // Remove ANSI / terminal control sequences.
        cleaned = cleaned.replace(
            /\x1B(?:[@-_]|\[[0-?]*[ -/]*[@-~])/g,
            ""
        );

        // Remove other terminal cursor/control characters.
        cleaned = cleaned.replace(
            /[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]/g,
            ""
        );

        // Convert escaped markdown headings back to markdown.
        cleaned = cleaned.replace(
            /^\\(#{1,6})/gm,
            "$1"
        );

        // Convert escaped markdown emphasis.
        cleaned = cleaned.replace(
            /\\\*\*/g,
            "**"
        );

        cleaned = cleaned.replace(
            /\\\*/g,
            "*"
        );

        // Remove accidental carriage returns.
        cleaned = cleaned.replace(/\r/g, "");

        return cleaned.trim();
    }


    function markdownToHtml(markdown) {

        let text = cleanArticle(markdown);

        if (!text) {
            return "";
        }

        const lines = text.split("\n");
        const output = [];

        let paragraph = [];
        let inList = false;

        function flushParagraph() {

            if (!paragraph.length) {
                return;
            }

            let content = paragraph.join(" ").trim();

            content = inlineMarkdown(content);

            if (content) {
                output.push(`<p>${content}</p>`);
            }

            paragraph = [];
        }


        function closeList() {

            if (inList) {
                output.push("</ul>");
                inList = false;
            }
        }


        for (let rawLine of lines) {

            const line = rawLine.trim();

            if (!line) {
                flushParagraph();
                closeList();
                continue;
            }


            // H1
            if (line.startsWith("# ") && !line.startsWith("## ")) {

                flushParagraph();
                closeList();

                output.push(
                    `<h4>${inlineMarkdown(line.slice(2).trim())}</h4>`
                );

                continue;
            }


            // H2
            if (line.startsWith("## ")) {

                flushParagraph();
                closeList();

                output.push(
                    `<h4>${inlineMarkdown(line.slice(3).trim())}</h4>`
                );

                continue;
            }


            // H3+
            if (/^#{3,6}\s/.test(line)) {

                flushParagraph();
                closeList();

                output.push(
                    `<h5>${inlineMarkdown(
                        line.replace(/^#{3,6}\s+/, "")
                    )}</h5>`
                );

                continue;
            }


            // Bullet list
            if (/^[-*]\s+/.test(line)) {

                flushParagraph();

                if (!inList) {
                    output.push("<ul>");
                    inList = true;
                }

                output.push(
                    `<li>${inlineMarkdown(
                        line.replace(/^[-*]\s+/, "")
                    )}</li>`
                );

                continue;
            }


            // Block quote
            if (line.startsWith(">")) {

                flushParagraph();
                closeList();

                output.push(
                    `<blockquote>${inlineMarkdown(
                        line.replace(/^>\s?/, "")
                    )}</blockquote>`
                );

                continue;
            }


            // Normal paragraph
            closeList();
            paragraph.push(line);
        }


        flushParagraph();
        closeList();

        return output.join("");
    }


    function inlineMarkdown(text) {

        let value = escapeHtml(text);

        // Links
        value = value.replace(
            /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
            '<a href="$2" target="_blank" rel="noopener">$1</a>'
        );

        // Bold
        value = value.replace(
            /\*\*(.+?)\*\*/g,
            "<strong>$1</strong>"
        );

        // Italic
        value = value.replace(
            /(?<!\*)\*([^*]+)\*(?!\*)/g,
            "<em>$1</em>"
        );

        // Inline code
        value = value.replace(
            /`([^`]+)`/g,
            "<code>$1</code>"
        );

        return value;
    }


    function findValue(story, keys) {

        for (const key of keys) {

            if (
                story &&
                story[key] !== undefined &&
                story[key] !== null &&
                story[key] !== ""
            ) {
                return story[key];
            }

        }

        return "";
    }


    function storyText(story) {

        const value = findValue(
            story,
            [
                "article",
                "story",
                "body",
                "content",
                "text",
                "article_text"
            ]
        );

        return typeof value === "string" ? value : "";
    }


    function getJournalist(story, index) {

        const value = findValue(
            story,
            [
                "journalist",
                "journalist_name",
                "role",
                "agent",
                "persona"
            ]
        );

        if (typeof value === "object") {

            return findValue(
                value,
                ["name", "role", "title"]
            ) || journalistNames[index];
        }

        return value || journalistNames[index];
    }


    function getTitle(story) {

        return findValue(
            story,
            [
                "headline",
                "title",
                "story_title",
                "article_title"
            ]
        ) || "UNTITLED STORY";
    }


    function renderStoryText(text) {

        if (!text) {

            return `
                <p>
                    Story generated, but article text was not found
                    in the newsroom output.
                </p>
            `;
        }

        return markdownToHtml(text);
    }


    function renderStories(stories) {

        const container =
            document.getElementById("stories");

        document.getElementById("storyCount").textContent =
            `${stories.length} STORIES`;


        if (!stories.length) {

            container.innerHTML = `
                <div class="empty">
                    <h3>NEWSROOM OUTPUT NOT FOUND</h3>
                    <p>
                        The newsroom is online, but no five-story bundle
                        has been generated yet.
                    </p>
                </div>
            `;

            return;
        }


        container.innerHTML = stories.map(
            (story, index) => {

                const journalist =
                    getJournalist(story, index);

                const title =
                    getTitle(story);

                const text =
                    storyText(story);


                return `
                    <article class="story">

                        <div class="story-side">

                            <div class="story-number">
                                STORY ${String(index + 1).padStart(2, "0")}
                            </div>

                            <div class="story-journalist">
                                ${escapeHtml(journalist)}
                            </div>

                        </div>


                        <div class="story-body">

                            <div class="story-kicker">
                                INDEPENDENT NEWSROOM REPORT
                            </div>

                            <h3>
                                ${escapeHtml(title)}
                            </h3>

                            <div class="story-text">
                                ${renderStoryText(text)}
                            </div>

                        </div>

                    </article>
                `;

            }
        ).join("");
    }


    async function loadNewsroom() {

        const statusText =
            document.getElementById("statusText");

        const statusDot =
            document.getElementById("statusDot");


        try {

            const response =
                await fetch(
                    "/newsroom/data",
                    { cache: "no-store" }
                );


            if (!response.ok) {
                throw new Error(
                    `HTTP ${response.status}`
                );
            }


            const data =
                await response.json();


            let stories = [];


            if (Array.isArray(data)) {

                stories = data;

            } else if (Array.isArray(data.stories)) {

                stories = data.stories;

            } else if (Array.isArray(data.results)) {

                stories = data.results;
            }


            renderStories(stories);


            statusText.textContent =
                data.status === "online"
                    ? "NEWSROOM ONLINE"
                    : "NEWSROOM READY";

        }


        catch (error) {

            console.error(
                "Newsroom load failed:",
                error
            );


            document.getElementById("storyCount")
                .textContent = "OFFLINE";


            document.getElementById("stories")
                .innerHTML = `
                    <div class="empty">
                        <h3>NEWSROOM DATA UNAVAILABLE</h3>
                        <p>
                            The newsroom page is working, but the story
                            data endpoint could not be reached.
                        </p>
                    </div>
                `;


            statusText.textContent =
                "DATA OFFLINE";

            statusDot.style.background =
                "#111111";
        }
    }


    loadNewsroom();

